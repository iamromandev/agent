# core
ENV=local
DEBUG=true
LOG_FORMAT=text
# db
DB_ENGINE=tortoise.backends.asyncpg
# "db" inside compose; "localhost" with DB_PORT=5410 when running on the host (make run).
DB_HOST=db
DB_PORT=5432
DB_USER=user
DB_PASSWORD=password
DB_NAME=name
# cors: comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000
# proxies whose X-Forwarded-For is trusted: comma-separated IPs or CIDRs, e.g.
# the load balancer's. Empty trusts none beyond uvicorn's 127.0.0.1 default.
TRUSTED_PROXIES=
