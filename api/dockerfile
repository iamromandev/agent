### base image ###
ARG PYTHON_VERSION=3.15.0

FROM python:$PYTHON_VERSION-slim AS base

ARG ENV
ARG WORK_DIR
ARG INSTALL_DIR
ARG PW_DIR

ENV ENV=$ENV
ENV WORK_DIR=$WORK_DIR
ENV INSTALL_DIR=$INSTALL_DIR
ENV PW_DIR=$PW_DIR

ENV PYTHONUNBUFFERED=true
ENV PYTHONFAULTHANDLER=true
ENV PYTHONDONTWRITEBYTECODE=true
ENV PYTHONHASHSEED=random

ENV VENV_PATH="$INSTALL_DIR/.venv"
ENV PATH="$VENV_PATH/bin:$PATH"


FROM base AS builder

ARG ENV
ARG WORK_DIR
ARG INSTALL_DIR
ARG PW_DIR

ENV ENV=$ENV
ENV WORK_DIR=$WORK_DIR
ENV INSTALL_DIR=$INSTALL_DIR
ENV PW_DIR=$PW_DIR

RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --upgrade pip
RUN pip install uv

WORKDIR $INSTALL_DIR
COPY pyproject.toml $INSTALL_DIR

RUN uv venv
RUN uv pip install -r $INSTALL_DIR/pyproject.toml


FROM base AS local

ARG ENV
ARG WORK_DIR
ARG INSTALL_DIR
ARG PW_DIR

ENV ENV=$ENV
ENV WORK_DIR=$WORK_DIR
ENV INSTALL_DIR=$INSTALL_DIR
ENV PW_DIR=$PW_DIR

WORKDIR $WORK_DIR

COPY --from=builder $INSTALL_DIR $INSTALL_DIR
COPY . $WORK_DIR


### prod image ###
# Build with the target and the same build args the builder stage needs (it has no defaults):
#   docker buildx build --platform linux/arm64 --target prod \
#     --build-arg ENV=prod --build-arg WORK_DIR=/workdir --build-arg INSTALL_DIR=/opt/install \
#     --build-arg PW_DIR=/pwdir -t <repository>:<tag> api
# Built on the shared base stage (the slim Python image), with dependencies copied from builder.
# Only pyproject.toml, src and scripts are copied: no tests, docs or developer .env. It runs as a
# non-root user and its default command serves without --reload. Migrations are a separate step:
#   python -m scripts.migrate
FROM base AS prod

ARG ENV
ARG WORK_DIR
ARG INSTALL_DIR
ARG PW_DIR

ENV ENV=$ENV
ENV WORK_DIR=$WORK_DIR
ENV INSTALL_DIR=$INSTALL_DIR
ENV PW_DIR=$PW_DIR

RUN useradd --system --uid 10001 --no-create-home --shell /usr/sbin/nologin user

WORKDIR $WORK_DIR

COPY --from=builder $INSTALL_DIR $INSTALL_DIR
COPY --chown=user:user pyproject.toml $WORK_DIR/
COPY --chown=user:user src $WORK_DIR/src
COPY --chown=user:user scripts $WORK_DIR/scripts

USER user

EXPOSE 8000

CMD ["uvicorn", "src.main:app", "--host", "0.0.0.0", "--port", "8000", "--loop", "uvloop"]
