# Where the app sends API calls. Leave empty for the default, `/api` on the
# page's own origin: the dev server forwards `/api/*` to AGENT_API_ORIGIN with
# the `/api` prefix stripped, so `/api/health/check` reaches `/health/check`.
# Set it to a full URL (e.g. https://api.example.com) to call the API directly.
VITE_API_BASE_URL=

# Dev server only (never in the bundle): where the proxy reaches the API.
# AGENT_API_ORIGIN=http://localhost:8000
