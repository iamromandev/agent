# Base URL of the agent API.
AGENT_API_URL=http://localhost:8000
# Seconds before an API request gives up.
AGENT_API_TIMEOUT=10
# Base URL of the Ollama server.
AGENT_OLLAMA_URL=http://localhost:11434
# Ollama model used by the agent.
AGENT_MODEL=qwen2.5:7b-instruct
# Context window requested from Ollama, in tokens.
AGENT_NUM_CTX=8192
# Seconds before a bash tool call is killed.
AGENT_BASH_TIMEOUT=120
# Maximum model calls in one turn.
AGENT_MAX_STEPS=25
