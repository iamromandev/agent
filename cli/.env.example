# Base URL of the agent API.
AGENT_API_URL=http://localhost:8000
# Seconds before an API request gives up.
AGENT_API_TIMEOUT=10
# Base URL of the Ollama server.
AGENT_OLLAMA_URL=http://localhost:11434
# Ollama model used by the agent.
AGENT_MODEL=qwen2.5:7b-instruct
# Context window requested from Ollama, in tokens.
AGENT_NUM_CTX=8192
# Seconds before a bash tool call is killed.
AGENT_BASH_TIMEOUT=120
# Maximum model calls in one turn.
AGENT_MAX_STEPS=25
# Where saved sessions live. Unset: $XDG_DATA_HOME/agent/sessions, else ~/.local/share/agent/sessions.
# AGENT_SESSIONS_DIR=
# Fraction of the context window (0 to 1) at which the history is compacted.
AGENT_COMPACT_AT=0.8
# Most recent user turns that compaction keeps verbatim.
AGENT_COMPACT_KEEP_TURNS=2
# Fraction of the context window (above 0, at most 0.5) that AGENTS.md files may use.
AGENT_INSTRUCTIONS_SHARE=0.25
# Seconds before an MCP tool call gives up (the server keeps running).
AGENT_MCP_TIMEOUT=60
# Seconds an MCP server may take to start and list its tools (a first `npx -y` download can be slow).
AGENT_MCP_START_TIMEOUT=120
